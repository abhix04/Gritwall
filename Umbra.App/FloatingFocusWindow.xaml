<ui:FluentWindow x:Class="Umbra.App.FloatingFocusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Width="500" Height="430" MinWidth="390" MinHeight="340"
        Background="#1A1A1A" ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None" WindowCornerPreference="Default"
        ResizeMode="CanResize" Topmost="True" ShowInTaskbar="True"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown" SizeChanged="Window_SizeChanged">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="8" CornerRadius="0" GlassFrameThickness="0" />
    </shell:WindowChrome.WindowChrome>
        <Grid ClipToBounds="True" Background="#1A1A1A">
            <Image x:Name="BackgroundImage" Stretch="UniformToFill" />
            <MediaElement x:Name="BackgroundVideo" LoadedBehavior="Manual" UnloadedBehavior="Manual" Stretch="UniformToFill" IsMuted="True" MediaEnded="BackgroundVideo_MediaEnded" />
            <Border Background="#7A101010" />
            <Grid x:Name="FullRoot" Margin="20">
                <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/><RowDefinition Height="34"/><RowDefinition Height="58"/></Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <TextBlock x:Name="PhaseText" HorizontalAlignment="Center" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Top" Margin="68,5" TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,3,0">
                        <Button shell:WindowChrome.IsHitTestVisibleInChrome="True" Width="30" Height="30" Padding="5" Background="Transparent" BorderThickness="0" Foreground="White"
                                Click="Compact_Click" ToolTip="Mode compact">
                            <ui:SymbolIcon Symbol="ArrowMinimize24" FontSize="14" />
                        </Button>
                        <Button shell:WindowChrome.IsHitTestVisibleInChrome="True" Width="30" Height="30" Padding="5" Background="Transparent" BorderThickness="0" Foreground="White" Click="Close_Click"><ui:SymbolIcon Symbol="Dismiss24" FontSize="14" /></Button>
                    </StackPanel>
                </Grid>
                <Grid x:Name="RingHost" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <!-- Optionnel (Réglages > Tâches de session) - juste les
                     tâches restantes, cochées elles disparaissent tout de
                     suite au lieu de rester barrées : cette fenêtre reste
                     petite/flottante, pas la place pour un historique. -->
                <StackPanel x:Name="FloatingTasksPanel" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Center" MaxWidth="170" Visibility="Collapsed" />
                <TextBlock x:Name="ModeDetailText" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" Opacity="0.72" TextTrimming="CharacterEllipsis" />
                <Grid Grid.Row="3">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Border Width="38" Height="38" CornerRadius="5" Margin="0,0,9,0"><Image x:Name="SpotifyThumbnail" Stretch="UniformToFill" /></Border>
                        <StackPanel VerticalAlignment="Center" MaxWidth="210">
                            <TextBlock x:Name="SpotifyTitle" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="SpotifyArtist" FontSize="11" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Mode compact (demande d'issue #6) : une barre fine et
                 discrète pour les petits écrans, où la fenêtre de 500x430
                 prend trop de place. Même fenêtre, même état, seule la
                 disposition change. -->
            <Grid x:Name="CompactRoot" Visibility="Collapsed" Background="#F01A1A1E">
                <Grid Margin="15,0,6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse x:Name="CompactDot" Grid.Column="0" Width="9" Height="9" Fill="#2DA5E6"
                             VerticalAlignment="Center" Margin="0,0,11,0" />
                    <TextBlock x:Name="CompactTime" Grid.Column="1" FontSize="22" FontWeight="SemiBold"
                               Foreground="White" VerticalAlignment="Center" Text="--:--" />
                    <TextBlock x:Name="CompactLabel" Grid.Column="2" FontSize="11" Opacity="0.66"
                               Foreground="White" VerticalAlignment="Center" Margin="12,2,10,0"
                               TextTrimming="CharacterEllipsis" />
                    <Button x:Name="CompactExpandButton" Grid.Column="3" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Width="30" Height="30" Padding="5" Background="Transparent" BorderThickness="0"
                            Foreground="White" Click="Compact_Click" ToolTip="Agrandir">
                        <ui:SymbolIcon Symbol="ArrowMaximize24" FontSize="13" />
                    </Button>
                    <Button Grid.Column="4" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Width="30" Height="30" Padding="5" Background="Transparent" BorderThickness="0"
                            Foreground="White" Click="Close_Click">
                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="13" />
                    </Button>
                </Grid>
            </Grid>
        </Grid>
</ui:FluentWindow>
